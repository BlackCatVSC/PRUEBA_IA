# =============================================================================
# Variables de Entorno - Asistente Virtual BancoEstado
# =============================================================================
#
# DESARROLLO: Copia este archivo como .env y completa con tus credenciales
#   cp .env.example .env
#
# PRODUCCION (EC2 / Docker): Configura estas variables como env vars del SO.
#   NO uses archivo .env en produccion. Usa:
#     - systemd: EnvironmentFile=/opt/bancoestado/.env (solo lectura root)
#     - Docker:  docker-compose.yml ya las lee del entorno del host
#     - EC2:     exportalas en /etc/profile.d/ o en el user-data script
#
# ADVERTENCIA DE SEGURIDAD:
# - NUNCA subas el archivo .env al repositorio
# - ROTA tus tokens si accidentalmente fueron expuestos
# - Usa AWS Secrets Manager para tokens en produccion real
# =============================================================================

# --- REQUERIDO para usar GPT-4o ---
# Sin esto la app funciona en modo DEMO (respuestas simuladas)
GITHUB_TOKEN="tu_token_github_aqui"

# --- GitHub Models API (no modificar salvo cambio de endpoint) ---
GITHUB_BASE_URL="https://models.inference.ai.azure.com"

# --- LangSmith (opcional) - trazabilidad y observabilidad ---
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY="tu_langsmith_key"
LANGSMITH_PROJECT="tu_proyecto"

# --- Email SMTP para reportes (opcional) ---
# Usa una contrasena de aplicacion, NUNCA tu contrasena personal
# https://myaccount.google.com/security -> Verificacion en 2 pasos -> Contrasena de aplicacion
EMAIL_FROM="tu_correo@gmail.com"
EMAIL_PASSWORD="tu_contraseña_de_aplicacion"
EMAIL_TO="destino@correo.cl"

# --- Produccion ---
FLASK_DEBUG="0"

# --- IL3.x — Observabilidad, Escalabilidad y Sostenibilidad ---
# Descomenta para sobreescribir los defaults
# LLM_MODELO_DEFECTO="gpt-4o"
# LLM_MODELO_POTENTE="gpt-4o"
# LLM_MODELO_LIGERO="gpt-4o-mini"
# LLM_COSTO_POR_1K="0.00075"
# CACHE_UMBRAL_SIMILITUD="0.75"
# CACHE_TTL_SEGUNDOS="3600"
# PROCESADOR_TAMANO_LOTE="5"
# ANOMALIAS_VENTANA="20"
# ANOMALIAS_FACTOR_SPIKE="2.5"
# ANOMALIAS_UMBRAL_ERROR_PCT="20.0"
# ANOMALIAS_UMBRAL_CACHE_PCT="50.0"
# OBS_TRUNCAR_ENTRADA="100"
# OBS_TRUNCAR_ERROR="120"
