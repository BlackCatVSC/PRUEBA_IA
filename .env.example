# Variables de Entorno - Agente BancoEstado
# Copia este archivo como .env y completa con tus credenciales:
#   cp .env.example .env
#
# ADVERTENCIA DE SEGURIDAD:
# - NUNCA subas el archivo .env al repositorio
# - ROTA tus tokens si accidentalmente fueron expuestos
# - Para produccion, usa variables de entorno del SO en lugar de .env

# GitHub Models API
OPENAI_BASE_URL="https://models.inference.ai.azure.com"
GITHUB_BASE_URL="https://models.inference.ai.azure.com"
GITHUB_TOKEN="tu_token_github_aqui"

# LangSmith (opcional) - trazabilidad y observabilidad
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY="tu_langsmith_key"
LANGSMITH_PROJECT="tu_proyecto"

# Email SMTP para reportes
# Usa una contrasena de aplicacion, NUNCA tu contrasena personal
# https://myaccount.google.com/security -> Verificacion en 2 pasos -> Contrasena de aplicacion
EMAIL_FROM="tu_correo@gmail.com"
EMAIL_PASSWORD="tu_contraseña_de_aplicacion"
EMAIL_TO="destino@correo.cl"

# IL3.x — Observabilidad, Escalabilidad y Sostenibilidad
# LLM_MODELO_DEFECTO="gpt-4o"        # Modelo LLM por defecto
# LLM_MODELO_POTENTE="gpt-4o"        # Modelo para consultas complejas
# LLM_MODELO_LIGERO="gpt-4o-mini"    # Modelo para consultas simples
# LLM_COSTO_POR_1K="0.00075"         # Costo promedio USD por 1K tokens
# CACHE_UMBRAL_SIMILITUD="0.75"      # Umbral minimo de similitud coseno
# CACHE_TTL_SEGUNDOS="3600"          # Tiempo de vida de entradas en cache
# PROCESADOR_TAMANO_LOTE="5"         # Tamaño de lote del procesador
# ANOMALIAS_VENTANA="20"             # Ventana deslizante para deteccion
# ANOMALIAS_FACTOR_SPIKE="2.5"       # Factor multiplicador para spike
# ANOMALIAS_UMBRAL_ERROR_PCT="20.0"  # Umbral de tasa de error %
# ANOMALIAS_UMBRAL_CACHE_PCT="50.0"  # Umbral de caida de cache %
# OBS_TRUNCAR_ENTRADA="100"          # Caracteres max en logs de entrada
# OBS_TRUNCAR_ERROR="120"            # Caracteres max en logs de error
